# NAEK Backend — environment variables (example)
# Copy this file to backend/.env and fill in real values for local development.
# NEVER commit backend/.env or any file containing real secrets.

# --- Server ---
PORT=8080
APP_ENV=development

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
# Vite's default dev port is 5173; it falls back to 5174, 5175, etc. if that
# port is busy, so a couple of fallback ports are listed here too.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Database (PostgreSQL) ---
# Example for local Docker Compose Postgres (see docker-compose.yml):
# DATABASE_URL=postgres://naek:naek@localhost:5432/naek?sslmode=disable
DATABASE_URL=

# --- Market data provider ---
# No real market-data provider is connected yet. Leave as "none" until a
# licensed/approved data source and its connector implementation exist.
# Valid values will expand as connectors are added (e.g. "idx-official").
MARKET_DATA_PROVIDER=none
MARKET_DATA_API_KEY=

# --- AI provider (NAEK AI research assistant) ---
# No real AI provider is connected yet. Leave as "none" until a provider is
# chosen and its connector (implementing internal/ai.Provider) exists.
# Valid values will expand as connectors are added (e.g. "openai", "anthropic").
# NAEK AI must retrieve data via explicit tools and cite sources — it must
# never fabricate prices, news, or predictions (see PRD.md FR-05).
AI_PROVIDER=none
AI_API_KEY=
